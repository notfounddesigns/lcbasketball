# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe to ship in a client bundle — Row Level Security, not
# secrecy, is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
